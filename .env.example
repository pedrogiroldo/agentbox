# Copy to .env and fill in. `make key` prints the public key of this machine.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Access (required): the public key(s) allowed to SSH into the box.
# One per line inside the quotes, or a single line with \n between them.
# ---------------------------------------------------------------------------
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... you@laptop"

# Host port that maps to the container's port 22.
SSH_PORT=2222

# Password login is off by default and should stay off on a public port.
# AGENTBOX_PASSWORD=

# ---------------------------------------------------------------------------
# Mirroring a project onto your own machine (docs/mirror.md)
#
# `agentbox-mirror` inside the box prints the command that mirrors a project
# onto your laptop, so agents write in the box while Gradle, adb or a GPU run
# on real hardware. To print it the box has to know the address a client
# outside dials — and that is the one thing a container cannot work out for
# itself, because the port mapping and any proxy live out here.
# ---------------------------------------------------------------------------
# The hostname or IP you SSH to. Empty means the printed command carries a
# <your-server> placeholder you have to replace by hand.
# AGENTBOX_SSH_HOST=box.example.com
# The *published* port, not the container's 22. Defaults to SSH_PORT above.
# AGENTBOX_SSH_PORT=2222

# ---------------------------------------------------------------------------
# The tailnet — the box's own front door (docs/tailscale.md)
#
# The box can join a Tailscale network as a node of its own, from inside the
# container: userspace networking, so no TUN device and no extra capability,
# and nothing published. That is what gives Collie below a way in, and it is
# also a nicer way to reach SSH than an open port.
#
#   off   never join (default)
#   auto  join at boot; a failure is a warning
#   on    join at boot; a failure stops the box
# AGENTBOX_TAILSCALE=off

# Joining is a command, not a credential: from a shell in the box, run
#
#     agentbox-tailscaled login
#
# It prints a URL and a QR code and waits — scan it with the phone you are
# about to use. Nothing below is needed for that.
#
# TS_AUTHKEY is only for a deploy platform starting the box with nobody
# watching. Use a *non-ephemeral* key: an ephemeral node is deleted from your
# tailnet shortly after it goes offline, which is the opposite of what this
# box's state volume is for. The box never copies it into its own config or
# into anything it persists.
# TS_AUTHKEY=tskey-auth-...
# The name this box takes on the tailnet. Empty lets Tailscale choose.
# TS_HOSTNAME=agentbox

# ---------------------------------------------------------------------------
# Collie — the mobile web UI (docs/collie.md)
#
# Collie is in the image and does not run. It is a browser interface to the
# herd: the agent waiting on you floats to the top, its permission prompts
# become buttons you tap, and you type with the normal keyboard instead of
# chording Ctrl+b on a phone.
#
# It needs no port and no proxy — it binds loopback, and the box's own
# `tailscale serve` reaches it from inside the same container. So it needs
# AGENTBOX_TAILSCALE above.
#
# It is also shell access to this box. Its device pairing protects *writes*
# only — reads are open to whoever on the tailnet reaches the URL, and the
# write gate does not exist until you pair a first device. Read
# docs/security.md, then docs/collie.md, before turning this on.
#
#   off   in the image, never started (default)
#   auto  started at boot; a failure is a warning
#   on    started at boot; a failure stops the box
# AGENTBOX_COLLIE=off
# COLLIE_PORT=8787

# Your tailnet login. `tailscale serve` injects the header this checks, so
# nobody else on the tailnet gets in. Set it.
# COLLIE_TRUSTED_USER=you@example.com

# Push notifications arrive on your phone when an agent blocks on you — which
# is most of the reason to want this on a phone at all. They come armed: the
# box generates the keypair before starting Collie, and the only step left is
# granting permission in the phone's Settings. Set to 0 to skip generating it.
# The keys are generated once and never replaced, because replacing them
# silently unsubscribes every device that had already said yes.
# AGENTBOX_COLLIE_PUSH=1
# Optional RFC 8292 contact, handed to Mozilla's and Google's push services.
# Nothing is derived from your git identity — this is yours to volunteer.
# COLLIE_PUSH_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# The herd
# ---------------------------------------------------------------------------
# The herdr server starts with the box, so agents and their panes exist before
# anyone logs in — that is what lets a phone open Collie and find them. Set to
# 0 for the old behaviour, where `herdr` in a shell starts it.
# AGENTBOX_HERDR_SERVER=1

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------
TZ=UTC
# The image ships en_US.UTF-8 and pt_BR.UTF-8.
AGENTBOX_LANG=en_US.UTF-8

# ---------------------------------------------------------------------------
# The banner you see when you open a terminal
# ---------------------------------------------------------------------------
# always (default) every interactive shell, including every herdr pane
# login  once per SSH login
# off    never
AGENTBOX_BANNER=always
# The line under the wordmark. Defaults to "by Pedro Giroldo" — change it.
AGENTBOX_BANNER_BY="by Your Name"

# ---------------------------------------------------------------------------
# Image / build
# ---------------------------------------------------------------------------
# Use the prebuilt image instead of building locally (also comment out the
# `build:` block in docker-compose.yml):
# AGENTBOX_IMAGE=ghcr.io/pedrogiroldo/agentbox:latest

# Pin versions for a reproducible image.
# NODE_VERSION=24.13.0
# NVIM_VERSION=stable
# CLAUDE_CODE_VERSION=latest
# CODEX_VERSION=latest
# OPENCODE_VERSION=latest
# "latest" takes the newest Collie release; a tag (v1.6.0) pins it and skips
# the GitHub API call the build would otherwise make.
# COLLIE_VERSION=latest

# Skip Tailscale (~30 MB) if the box will never join a tailnet. Collie has no
# other way in, so this also turns Collie into a binary you cannot reach.
# INSTALL_TAILSCALE=true

# Skip the Docker CLI (~120 MB) if you will never mount the docker socket.
# INSTALL_DOCKER_CLI=true

# Bake the Docker engine into the image (+192 MB). Off: the box installs it on
# the first boot instead, into the state volume, which keeps the image small
# and gets you the same daemon a couple of minutes later. Turn it on for a box
# that must run containers immediately, or one with no network.
# INSTALL_DOCKER_ENGINE=false

# What the box does about Docker at boot:
#   install  fetch the engine when it is missing, then run it (default)
#   auto     run it only if something already installed it
#   on       a box without a working daemon refuses to boot (and waits for
#            the install before sshd, so the first boot is slower)
#   off      never -- no daemon, no download
# The daemon needs the `privileged: true` in docker-compose.yml. That is
# root-equivalent access to the host: read docs/security.md, and use `off`
# plus deleting that line if it is not a trade you want.
# AGENTBOX_DOCKER=install

# Stopping your containers, then saving the system layer, on the way out.
# AGENTBOX_STOP_GRACE=90s
# Skip warming the Neovim plugin cache to get a faster, smaller build.
# PREINSTALL_NVIM_PLUGINS=true

# ---------------------------------------------------------------------------
# Persistence beyond /home/dev
#
# What you `apt install`, and what you change under /usr/local, /opt and /etc,
# is recorded and put back on every boot -- see docs/persistence.md. A fresh
# start is deleting the two volumes below.
# ---------------------------------------------------------------------------
# Set to 0 to keep only /home/dev across a recreate.
# AGENTBOX_PERSIST=1
# Seconds between automatic saves. A graceful stop saves as well; 0 leaves
# only the shutdown save and hand-run `sudo agentbox-persist save`.
# AGENTBOX_PERSIST_INTERVAL=300

# ---------------------------------------------------------------------------
# Names — change these to run more than one box on the same host
# ---------------------------------------------------------------------------
# AGENTBOX_NAME=agentbox
# AGENTBOX_HOSTNAME=agentbox
# AGENTBOX_VOLUME=agentbox-home
# AGENTBOX_STATE_VOLUME=agentbox-state
