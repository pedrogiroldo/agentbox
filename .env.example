# Copy to .env and fill in. `make key` prints the public key of this machine.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Access (required): the public key(s) allowed to SSH into the box.
# One per line inside the quotes, or a single line with \n between them.
# ---------------------------------------------------------------------------
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... you@laptop"

# Host port that maps to the container's port 22.
SSH_PORT=2222

# Password login is off by default and should stay off on a public port.
# AGENTBOX_PASSWORD=

# ---------------------------------------------------------------------------
# Mirroring a project onto your own machine (docs/mirror.md)
#
# `agentbox-mirror` inside the box prints the command that mirrors a project
# onto your laptop, so agents write in the box while Gradle, adb or a GPU run
# on real hardware. To print it the box has to know the address a client
# outside dials — and that is the one thing a container cannot work out for
# itself, because the port mapping and any proxy live out here.
# ---------------------------------------------------------------------------
# The hostname or IP you SSH to. Empty means the printed command carries a
# <your-server> placeholder you have to replace by hand.
# AGENTBOX_SSH_HOST=box.example.com
# The *published* port, not the container's 22. Defaults to SSH_PORT above.
# AGENTBOX_SSH_PORT=2222

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------
TZ=UTC
# The image ships en_US.UTF-8 and pt_BR.UTF-8.
AGENTBOX_LANG=en_US.UTF-8

# ---------------------------------------------------------------------------
# The banner you see when you open a terminal
# ---------------------------------------------------------------------------
# always (default) every interactive shell, including every herdr pane
# login  once per SSH login
# off    never
AGENTBOX_BANNER=always
# The line under the wordmark. Defaults to "by Pedro Giroldo" — change it.
AGENTBOX_BANNER_BY="by Your Name"

# ---------------------------------------------------------------------------
# Image / build
# ---------------------------------------------------------------------------
# Use the prebuilt image instead of building locally (also comment out the
# `build:` block in docker-compose.yml):
# AGENTBOX_IMAGE=ghcr.io/pedrogiroldo/agentbox:latest

# Pin versions for a reproducible image.
# NODE_VERSION=24.13.0
# NVIM_VERSION=stable
# CLAUDE_CODE_VERSION=latest
# CODEX_VERSION=latest
# OPENCODE_VERSION=latest

# Skip the Docker CLI (~120 MB) if you will never mount the docker socket.
# INSTALL_DOCKER_CLI=true

# Bake the Docker engine into the image (+192 MB). Off: the box installs it on
# the first boot instead, into the state volume, which keeps the image small
# and gets you the same daemon a couple of minutes later. Turn it on for a box
# that must run containers immediately, or one with no network.
# INSTALL_DOCKER_ENGINE=false

# What the box does about Docker at boot:
#   install  fetch the engine when it is missing, then run it (default)
#   auto     run it only if something already installed it
#   on       a box without a working daemon refuses to boot (and waits for
#            the install before sshd, so the first boot is slower)
#   off      never -- no daemon, no download
# The daemon needs the `privileged: true` in docker-compose.yml. That is
# root-equivalent access to the host: read docs/security.md, and use `off`
# plus deleting that line if it is not a trade you want.
# AGENTBOX_DOCKER=install

# Stopping your containers, then saving the system layer, on the way out.
# AGENTBOX_STOP_GRACE=90s
# Skip warming the Neovim plugin cache to get a faster, smaller build.
# PREINSTALL_NVIM_PLUGINS=true

# ---------------------------------------------------------------------------
# Persistence beyond /home/dev
#
# What you `apt install`, and what you change under /usr/local, /opt and /etc,
# is recorded and put back on every boot -- see docs/persistence.md. A fresh
# start is deleting the two volumes below.
# ---------------------------------------------------------------------------
# Set to 0 to keep only /home/dev across a recreate.
# AGENTBOX_PERSIST=1
# Seconds between automatic saves. A graceful stop saves as well; 0 leaves
# only the shutdown save and hand-run `sudo agentbox-persist save`.
# AGENTBOX_PERSIST_INTERVAL=300

# ---------------------------------------------------------------------------
# Names — change these to run more than one box on the same host
# ---------------------------------------------------------------------------
# AGENTBOX_NAME=agentbox
# AGENTBOX_HOSTNAME=agentbox
# AGENTBOX_VOLUME=agentbox-home
# AGENTBOX_STATE_VOLUME=agentbox-state
