# /etc/ssh/sshrc — run by sshd for every session, interactive or not, after
# authentication and before the user's shell or command starts.
#
# sshd is control plane: the group the box weights ahead of its workload so
# that a login is fast even when the agents have saturated the machine. The
# session it is about to start is not. An interactive login moves itself in
# env.sh; a one-shot command (`ssh box make test`, a mutagen agent, scp, mosh)
# never reads env.sh, so it is moved here instead. $PPID is the process that
# will exec the shell or command; cgroup membership survives the exec.
#
# Root stays where it is: `make root` and friends are the rescue path.
if [ "$(id -u)" != 0 ] && [ -r /run/agentbox-isolation ] && [ -x /usr/local/bin/agentbox-cgroup ]; then
    sudo -n /usr/local/bin/agentbox-cgroup enter work "$PPID" >/dev/null 2>&1
fi
true
